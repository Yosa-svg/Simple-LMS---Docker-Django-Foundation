# ==============================================================================
# Simple LMS — Environment Variables Template
# ==============================================================================
# Salin file ini: cp .env.example .env
# Isi nilai yang sesuai sebelum menjalankan docker-compose up --build
# JANGAN commit file .env ke repository!
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Settings
# ------------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production-minimum-50-chars
ALLOWED_HOSTS=localhost,127.0.0.1,app

# ------------------------------------------------------------------------------
# PostgreSQL — Database Utama
# ------------------------------------------------------------------------------
POSTGRES_DB=simple_lms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password

# Django database connection (harus sama dengan POSTGRES_* di atas)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=simple_lms_db
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=db
DB_PORT=5432

# ------------------------------------------------------------------------------
# Django Settings Module
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings

# ------------------------------------------------------------------------------
# Redis — Cache, Session & Celery Result Backend
# DB 0: Application Cache
# DB 1: Celery Result Backend
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# MongoDB — Analytics & Activity Logs
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://mongodb:27017
MONGO_DB_NAME=simple_lms_logs

# Jika MongoDB menggunakan autentikasi (production):
# MONGO_URI=mongodb://mongo_user:mongo_password@mongodb:27017/

# ------------------------------------------------------------------------------
# RabbitMQ — Message Broker untuk Celery
# Management UI: http://localhost:15672
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Celery broker & result backend
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------------------------------------------------------------------------------
# Email (Development: console backend — email dicetak ke stdout)
# Untuk production, ganti dengan SMTP settings
# ------------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@simplelms.id

# Untuk production (contoh Gmail SMTP):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
